{
  "compilerOptions": {
    "strict": true,
    "types": ["vite-plugin-pwa/client", "node", "react", "react-dom"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@miti/types": ["./src/lib/types"],
      "@miti/query/*": ["./src/lib/query/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "./index.js", "vite.config.ts"],
  "exclude": ["src/service-worker"]
}
